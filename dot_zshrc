# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt append_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt inc_append_history
setopt extended_history

# Exports
[[ -f "$HOME/.config/zsh/exports.zsh" ]] && source "$HOME/.config/zsh/exports.zsh"
[[ -f "$HOME/.config/zsh/local.zsh" ]] && source "$HOME/.config/zsh/local.zsh"

# Aliases
[[ -f "$HOME/.config/zsh/aliases.zsh" ]] && source "$HOME/.config/zsh/aliases.zsh"

# Functions
[[ -f "$HOME/.config/zsh/functions.zsh" ]] && source "$HOME/.config/zsh/functions.zsh"

# Keybindings
[[ -f "$HOME/.config/zsh/keybindings.zsh" ]] && source "$HOME/.config/zsh/keybindings.zsh"

# Tools
[[ -f "$HOME/.config/zsh/tools.zsh" ]] && source "$HOME/.config/zsh/tools.zsh"

# Basic options
setopt interactivecomments
setopt no_beep

# Place Zsh's right prompt flush with the terminal edge.
typeset -g ZLE_RPROMPT_INDENT=0

# Starship prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"

  # Keep only the status character on submitted command lines.
  _starship_transient_prompt() {
    if (( ${STARSHIP_CMD_STATUS:-0} == 0 )); then
      command starship module custom.transient_success
    else
      command starship module custom.transient_error
    fi
  }

  TRANSIENT_PROMPT_TRANSIENT_PROMPT='$(_starship_transient_prompt)'
  TRANSIENT_PROMPT_TRANSIENT_RPROMPT=''
fi

# Antidote
if [[ -f /usr/share/zsh-antidote/antidote.zsh ]]; then
  source /usr/share/zsh-antidote/antidote.zsh
elif [[ -f /opt/homebrew/opt/antidote/share/antidote/antidote.zsh ]]; then
  source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh
elif [[ -f /usr/local/opt/antidote/share/antidote/antidote.zsh ]]; then
  source /usr/local/opt/antidote/share/antidote/antidote.zsh
elif [[ -f "$HOME/.antidote/antidote.zsh" ]]; then
  source "$HOME/.antidote/antidote.zsh"
fi

if typeset -f antidote >/dev/null 2>&1; then
  if [[ ! -f "$HOME/.zsh_plugins.zsh" || "$HOME/.zsh_plugins.txt" -nt "$HOME/.zsh_plugins.zsh" ]]; then
    antidote bundle < "$HOME/.zsh_plugins.txt" > "$HOME/.zsh_plugins.zsh"
  fi

  source "$HOME/.zsh_plugins.zsh"
fi

# Completion
zmodload -i zsh/complist
autoload -Uz compinit

if [[ -n "$HOME/.zcompdump"(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

unsetopt menu_complete
setopt auto_menu
zstyle ':completion:*:*:*:*:*' menu select
